<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows.Gaming.Input (GamepadService) доступен только при TFM с версией
         Windows SDK. Минимальная поддерживаемая ОС — Windows 10 1903. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>GameShift</AssemblyName>
    <RootNamespace>GameShift</RootNamespace>
    <Version>1.0.0</Version>
    <Product>GameShift</Product>
    <Company>GameShift Team</Company>
    <Copyright>© 2025 GameShift Team</Copyright>
    <!-- Когда появится финальная иконка — положить рядом с .csproj
         и раскомментировать строку ниже. Иконка в трее рендерится из WPF
         в TrayIconFactory.CreateGamepadIcon() и от ApplicationIcon не зависит. -->
    <!-- <ApplicationIcon>app.ico</ApplicationIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      H.NotifyIcon.Wpf 2.4.1 (Dec 2025) сменил TFM-набор на .NET 10 + .NET Framework 4.6.2,
      из-за чего NuGet под net8.0-windows откатывался на .NET Framework target и выдавал NU1701.
      2.3.2 — последняя версия линейки 2.x, поддерживающая .NET 6/7/8 нативно.
    -->
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" />
    <PackageReference Include="WPF-UI" Version="4.2.1" />
  </ItemGroup>

</Project>
