<Application x:Class="GameShift.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             ShutdownMode="OnExplicitShutdown"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════════════
                 ПАЛИТРА
                 ═══════════════════════════════════════════════════════════ -->
            <Color x:Key="ActiveColor">#00D26A</Color>
            <Color x:Key="AccentColor">#3A8AFF</Color>
            <Color x:Key="WarnColor">#FFB547</Color>
            <Color x:Key="DangerColor">#FF5252</Color>
            <Color x:Key="MutedColor">#A0A0A0</Color>
            <Color x:Key="OffColor">#707070</Color>

            <SolidColorBrush x:Key="ActiveBrush" Color="{StaticResource ActiveColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="WarnBrush"   Color="{StaticResource WarnColor}"/>
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
            <SolidColorBrush x:Key="MutedBrush"  Color="{StaticResource MutedColor}"/>
            <SolidColorBrush x:Key="OffBrush"    Color="{StaticResource OffColor}"/>
            <SolidColorBrush x:Key="DimBrush"    Color="#80FFFFFF"/>

            <!-- Карточки и разделители -->
            <SolidColorBrush x:Key="CardBg"          Color="#0AFFFFFF"/>
            <SolidColorBrush x:Key="CardBorder"      Color="#15FFFFFF"/>
            <SolidColorBrush x:Key="CardBgHover"     Color="#10FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderHover" Color="#25FFFFFF"/>
            <SolidColorBrush x:Key="DividerBrush"    Color="#1AFFFFFF"/>

            <!-- Полу-прозрачные подложки иконок (исп. в code-behind через альфу) -->
            <SolidColorBrush x:Key="HeroIconBgActive"   Color="#1A3A8AFF"/>
            <SolidColorBrush x:Key="HeroIconBgInactive" Color="#1A707070"/>

            <!-- ═══════════════════════════════════════════════════════════
                 СТИЛИ КАРТОЧЕК
                 ═══════════════════════════════════════════════════════════ -->
            <Style x:Key="GlassCardBorder" TargetType="Border">
                <Setter Property="Background"      Value="{StaticResource CardBg}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="12"/>
                <Setter Property="Padding"         Value="18"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background"  Value="{StaticResource CardBgHover}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GlassCardStatic" TargetType="Border">
                <!-- Версия без hover для не-интерактивных карточек -->
                <Setter Property="Background"      Value="{StaticResource CardBg}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="12"/>
                <Setter Property="Padding"         Value="18"/>
            </Style>

            <Style x:Key="GlassCardStaticTight" TargetType="Border" BasedOn="{StaticResource GlassCardStatic}">
                <!-- Чуть более компактная карточка для левой колонки -->
                <Setter Property="Padding" Value="16"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════
                 СТИЛИ ТЕКСТА
                 ═══════════════════════════════════════════════════════════ -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize"          Value="13"/>
                <Setter Property="FontWeight"        Value="SemiBold"/>
                <Setter Property="Foreground"        Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SubLabel" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Margin"     Value="0,0,0,6"/>
            </Style>

            <Style x:Key="MicroLabel" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="Margin"     Value="0,0,0,4"/>
            </Style>

            <Style x:Key="MiniStatValue" TargetType="TextBlock">
                <Setter Property="FontSize"          Value="12"/>
                <Setter Property="Foreground"        Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="SettingRowTitle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="12"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="SettingRowSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize"      Value="10"/>
                <Setter Property="Foreground"    Value="{StaticResource DimBrush}"/>
                <Setter Property="TextTrimming"  Value="CharacterEllipsis"/>
                <Setter Property="Margin"        Value="0,2,0,0"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════
                 СТАНДАРТНЫЕ ОТСТУПЫ ВНУТРИ КАРТОЧЕК
                 Один источник правды — меняешь здесь, синхронно меняется
                 по всему окну.
                 ═══════════════════════════════════════════════════════════ -->

            <!-- Шапка карточки: «иконка + заголовок секции» -->
            <Style x:Key="CardHeader" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin"      Value="0,0,0,14"/>
            </Style>

            <!-- Иконка у заголовка секции (14×14, белая, отступ до текста 8) -->
            <Style x:Key="SectionTitleIcon" TargetType="iconPacks:PackIconMaterial">
                <Setter Property="Width"              Value="14"/>
                <Setter Property="Height"             Value="14"/>
                <Setter Property="Foreground"         Value="White"/>
                <Setter Property="VerticalAlignment"  Value="Center"/>
                <Setter Property="Margin"             Value="0,0,8,0"/>
            </Style>

            <!-- Расстояние между настройками внутри карточки (один ритм везде) -->
            <Style x:Key="SettingRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <!-- Разделитель внутри карточки -->
            <Style x:Key="CardDivider" TargetType="Rectangle">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Fill"   Value="{StaticResource DividerBrush}"/>
                <Setter Property="Margin" Value="0,2,0,12"/>
            </Style>

            <!-- Иконка «слева» в строке тоггла (13×13, серая) -->
            <Style x:Key="RowLeadIcon" TargetType="iconPacks:PackIconMaterial">
                <Setter Property="Width"             Value="13"/>
                <Setter Property="Height"            Value="13"/>
                <Setter Property="Foreground"        Value="{StaticResource MutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin"            Value="0,0,8,0"/>
            </Style>

            <!-- Подпись справа от иконки в строке тоггла -->
            <Style x:Key="RowLeadText" TargetType="TextBlock">
                <Setter Property="FontSize"          Value="12"/>
                <Setter Property="Foreground"        Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════
                 ПИЛЮЛИ КНОПОК ГЕЙМПАДА (блок «Комбинация активации»)
                 Создаются программно в code-behind при показе записанной
                 комбинации; стиль вынесен сюда, чтобы внешний вид
                 настраивался декларативно.
                 ═══════════════════════════════════════════════════════════ -->
            <Style x:Key="GamepadButtonPill" TargetType="Border">
                <Setter Property="Background"      Value="#15FFFFFF"/>
                <Setter Property="BorderBrush"     Value="#30FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="6"/>
                <Setter Property="Padding"         Value="10,4"/>
                <Setter Property="MinWidth"        Value="32"/>
            </Style>

            <Style x:Key="GamepadButtonPillText" TargetType="TextBlock">
                <Setter Property="FontSize"            Value="11"/>
                <Setter Property="FontWeight"          Value="SemiBold"/>
                <Setter Property="Foreground"          Value="White"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment"   Value="Center"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════════════
                 БЕЙДЖ ЛИЦЕНЗИИ
                 Состояние задаётся через Tag ("warn" | "danger"). Это
                 позволяет style-триггерам корректно отрабатывать hover
                 в обоих состояниях. Раньше code-behind ставил Background
                 локально, что по приоритету DP перебивало IsMouseOver
                 trigger и подсветка при наведении пропадала.
                 ═══════════════════════════════════════════════════════════ -->
            <Style x:Key="LicensePill" TargetType="Border">
                <!-- Дефолт = warn (пробный период, > 3 дней) -->
                <Setter Property="Background"      Value="#1AFFB547"/>
                <Setter Property="BorderBrush"     Value="#40FFB547"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="14"/>
                <Setter Property="Padding"         Value="12,6"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Style.Triggers>
                    <!-- warn + hover -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                            <Condition Binding="{Binding Tag,         RelativeSource={RelativeSource Self}}" Value="warn"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background"  Value="#26FFB547"/>
                        <Setter Property="BorderBrush" Value="#60FFB547"/>
                    </MultiDataTrigger>

                    <!-- danger idle -->
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="danger">
                        <Setter Property="Background"  Value="#1AFF5252"/>
                        <Setter Property="BorderBrush" Value="#40FF5252"/>
                    </DataTrigger>

                    <!-- danger + hover -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                            <Condition Binding="{Binding Tag,         RelativeSource={RelativeSource Self}}" Value="danger"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background"  Value="#26FF5252"/>
                        <Setter Property="BorderBrush" Value="#60FF5252"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
